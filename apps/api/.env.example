# =============================================================================
# fit-app — Desarrollo Local
# =============================================================================
# Para desarrollo local con PostgreSQL en Docker:
#   docker run -d --name fit-postgres \
#     -e POSTGRES_USER=admin \
#     -e POSTGRES_PASSWORD=12345678 \
#     -e POSTGRES_DB=proyectos \
#     -p 5432:5432 postgres:17
# =============================================================================

DATABASE_URL="postgresql://admin:12345678@localhost:5432/proyectos?schema=public"
DIRECT_URL="postgresql://admin:12345678@localhost:5432/proyectos?schema=public"
JWT_SECRET="super-secret-jwt-key-change-in-production"

# =============================================================================
# Redis — Usado por Bull queues y PubSub para tiempo real
# =============================================================================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# =============================================================================
# PubSub Adapter — Soporte WebSocket en tiempo real
#   memory → desarrollo local (un solo servidor)
#   redis  → producción con múltiples instancias (requiere Redis)
# =============================================================================
PUBSUB_ADAPTER="memory"

CORS_ORIGIN="http://localhost:3000,http://localhost:8081"
PORT=4000
UPLOAD_DIR="./uploads"
APP_URL="http://localhost:4000"
WGER_API_URL="https://wger.de/api/v2"

# =============================================================================
# Imágenes dinámicas — Proveedores externos
# =============================================================================
UNSPLASH_ACCESS_KEY="your_unsplash_access_key"
PEXELS_API_KEY="your_pexels_api_key"
PIXABAY_API_KEY="your_pixabay_api_key"

# =============================================================================
# Push Notifications — Configurar según plataforma
# =============================================================================
# Opción 1: Expo Push (app nativa iOS/Android)
# Obtener en: https://expo.dev/accounts/[username]/settings/access-tokens
# EXPO_ACCESS_TOKEN="your_expo_access_token"

# Opción 2: Web Push API (PWA)
# Generar con: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_EMAIL="mailto:your@email.com"
