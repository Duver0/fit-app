generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  SUPER_ADMIN

  @@map("user_role")
}

enum GroupMemberRole {
  OWNER
  MEMBER

  @@map("group_member_role")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED

  @@map("invite_status")
}

enum ExerciseUnit {
  KG
  REPS
  MIN
  SEC
  M
  REPS_AND_WEIGHT

  @@map("exercise_unit")
}

enum DisputeStatus {
  OPEN
  APPROVED
  REJECTED

  @@map("dispute_status")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  auth0Id   String   @unique @map("auth0_id")
  passwordHash String? @map("password_hash")
  email     String   @unique
  phone     String?  @map("phone")
  name      String
  avatarUrl String?  @map("avatar_url") @db.Text
  role            UserRole  @default(USER)
  routineEnabled  Boolean   @default(false) @map("routine_enabled")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships  GroupMember[]
  performances PerformanceRecord[]
  disputeVotes DisputeVote[]
  ownedGroups  Group[]
  sentInvitations Invitation[]
  initiatedDisputes Dispute[]
  createdExercises  Exercise[]
  createdCategories ExerciseCategory[]
  routineDays       RoutineDay[]

  @@map("users")
}

model RoutineDay {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week")
  name      String?  @map("name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]

  @@unique([userId, dayOfWeek])
  @@index([userId])
  @@map("routine_days")
}

model RoutineExercise {
  id         String   @id @default(uuid()) @db.Uuid
  dayId      String   @map("day_id") @db.Uuid
  exerciseId String   @map("exercise_id") @db.Uuid
  sortOrder  Int      @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  day      RoutineDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([dayId, exerciseId])
  @@index([dayId, sortOrder])
  @@map("routine_exercises")
}

model Group {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?  @db.Text
  avatarUrl   String?  @map("avatar_url") @db.Text
  ownerId     String   @map("owner_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner       User                @relation(fields: [ownerId], references: [id])
  members     GroupMember[]
  exercises   Exercise[]
  categories  ExerciseCategory[]
  invitations Invitation[]
  performances PerformanceRecord[]

  @@map("groups")
}

model GroupMember {
  id       String          @id @default(uuid()) @db.Uuid
  userId   String          @map("user_id") @db.Uuid
  groupId  String          @map("group_id") @db.Uuid
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now()) @map("joined_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
  @@index([userId])
  @@map("group_members")
}

model Invitation {
  id           String       @id @default(uuid()) @db.Uuid
  groupId      String       @map("group_id") @db.Uuid
  inviterId    String       @map("inviter_id") @db.Uuid
  inviteeEmail String       @map("invitee_email")
  status       InviteStatus @default(PENDING)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter User  @relation(fields: [inviterId], references: [id])

  @@index([groupId])
  @@index([inviteeEmail])
  @@map("invitations")
}

model ExerciseCategory {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  name      String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator   User       @relation(fields: [createdBy], references: [id])
  exercises Exercise[]

  @@unique([groupId, name])
  @@index([groupId])
  @@map("exercise_categories")
}

model Exercise {
  id        String       @id @default(uuid()) @db.Uuid
  groupId   String       @map("group_id") @db.Uuid
  categoryId String?     @map("category_id") @db.Uuid
  name      String
  unit      ExerciseUnit @default(KG)
  imageUrl  String?      @map("image_url") @db.Text
  createdBy String       @map("created_by") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // Datos enriquecidos desde wger.de
  wgerId           Int?     @map("wger_id")
  wgerCategory     String?  @map("wger_category") @db.Text
  wgerMuscles      String?  @map("wger_muscles") @db.Text
  wgerEquipment    String?  @map("wger_equipment") @db.Text
  wgerInstructions String?  @map("wger_instructions") @db.Text

  group        Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  category     ExerciseCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creator      User                @relation(fields: [createdBy], references: [id])
  performances     PerformanceRecord[]
  routineExercises RoutineExercise[]

  @@unique([groupId, name, unit])
  @@index([groupId])
  @@map("exercises")
}

model PerformanceRecord {
  id         String   @id @default(uuid()) @db.Uuid
  exerciseId String   @map("exercise_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  value      Float
  reps       Int?     @map("reps")
  weight     Float?   @map("weight")
  recordedAt DateTime @default(now()) @map("recorded_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  exercise Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id])
  group    Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  disputes Dispute[]

  @@unique([exerciseId, userId, groupId])
  @@index([groupId, exerciseId(sort: Desc)])
  @@index([userId])
  @@map("performance_records")
}

model Dispute {
  id              String        @id @default(uuid()) @db.Uuid
  performanceId   String        @map("performance_id") @db.Uuid
  initiatedById   String        @map("initiated_by_id") @db.Uuid
  reason          String        @db.Text
  status          DisputeStatus @default(OPEN)
  createdAt       DateTime      @default(now()) @map("created_at")
  resolvedAt      DateTime?     @map("resolved_at")
  expiresAt       DateTime      @map("expires_at")

  performance PerformanceRecord @relation(fields: [performanceId], references: [id], onDelete: Cascade)
  initiator   User             @relation(fields: [initiatedById], references: [id])
  votes       DisputeVote[]

  @@index([performanceId])
  @@index([status])
  @@map("disputes")
}

model DisputeVote {
  id        String   @id @default(uuid()) @db.Uuid
  disputeId String   @map("dispute_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  vote      Boolean
  createdAt DateTime @default(now()) @map("created_at")

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([disputeId, userId])
  @@index([disputeId])
  @@map("dispute_votes")
}

model GroupImageCache {
  id             String   @id @default(uuid()) @db.Uuid
  category       String   @map("category")
  searchTerm     String   @map("search_term")
  provider       String   @map("provider")
  imageUrl       String   @map("image_url") @db.Text
  thumbnailUrl   String   @map("thumbnail_url") @db.Text
  author         String   @map("author")
  attributionUrl String   @map("attribution_url") @db.Text
  imageId        String   @map("image_id")
  width          Int      @default(0)
  height         Int      @default(0)
  downloadedAt   DateTime @default(now()) @map("downloaded_at")
  expiresAt      DateTime @map("expires_at")

  @@index([category])
  @@index([category, searchTerm])
  @@index([expiresAt])
  @@map("group_image_cache")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  entity    String
  entityId  String   @map("entity_id")
  actorId   String   @map("actor_id") @db.Uuid
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@map("audit_logs")
}
