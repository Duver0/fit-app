{
  "name": "fit-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run dev -w apps/api",
    "api:build": "npm run build -w apps/api",
    "mobile:dev": "npm run dev -w apps/mobile",
    "db:generate": "npm run prisma:generate -w apps/api",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "db:push": "npm run prisma:push -w apps/api",
    "lint": "npm run lint -w apps/api && npm run lint -w apps/mobile",
    "test": "npm run test -w apps/api && npm run test -w apps/mobile",
    "test-lint": "echo ok"
  },
  "dependencies": {
    "@nestjs/schedule": "^6.1.3",
    "expo-font": "11.10.3"
  },
  "description": "Plataforma de ranking de gimnasio. Usuarios crean grupos, registran su progreso en ejercicios y compiten en rankings con sistema de disputas por mayoría simple.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Duver0/fit-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Duver0/fit-app/issues"
  },
  "homepage": "https://github.com/Duver0/fit-app#readme"
}
