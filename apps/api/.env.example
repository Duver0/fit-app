# =============================================================================
# fit-app — Desarrollo Local
# =============================================================================
# Para desarrollo local con PostgreSQL en Docker:
#   docker run -d --name fit-postgres \
#     -e POSTGRES_USER=admin \
#     -e POSTGRES_PASSWORD=12345678 \
#     -e POSTGRES_DB=proyectos \
#     -p 5432:5432 postgres:17
# =============================================================================

DATABASE_URL="postgresql://admin:12345678@localhost:5432/proyectos?schema=public"
JWT_SECRET="super-secret-jwt-key-change-in-production"
REDIS_HOST="localhost"
REDIS_PORT=6379
CORS_ORIGIN="http://localhost:3000,http://localhost:8081"
PORT=4000
UPLOAD_DIR="./uploads"
APP_URL="http://localhost:4000"
# wger API (gratuita, open-source, sin key) — https://wger.de/api/v2
WGER_API_URL="https://wger.de/api/v2"

# =============================================================================
# Imágenes dinámicas — Proveedores externos
# Orden de prioridad: Unsplash → Pexels → Pixabay
# Si no se configura ninguno, las imágenes de categoría no estarán disponibles
# =============================================================================
# Unsplash — https://unsplash.com/developers
UNSPLASH_ACCESS_KEY="your_unsplash_access_key"
# Pexels — https://www.pexels.com/api/
PEXELS_API_KEY="your_pexels_api_key"
# Pixabay — https://pixabay.com/api/docs/
PIXABAY_API_KEY="your_pixabay_api_key"
